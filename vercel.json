{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/smart-refresh",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=north",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=south",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=east",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=west",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=central",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/refresh-facts?batch=uts",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/cron/refresh-cache",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/sync-electoral",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-electoral?state=TN",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/sync-electoral?state=MH",
      "schedule": "0 3 * * 2"
    },
    {
      "path": "/api/cron/sync-electoral?state=UP",
      "schedule": "0 3 * * 3"
    },
    {
      "path": "/api/cron/sync-electoral?state=WB",
      "schedule": "0 3 * * 4"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://reviewyourleader.com"
  }
}
